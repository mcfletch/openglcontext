dist
.eric?project
*.~?~
core
core*
pydoc/*.html
test-results
tests/test.jpg
*.egg-info
build
tests/callcontext.txt

# Generated test-run outputs (finding 3.29): keep only the canonical
# tests/reference_images/<name>.png baselines, never the diff/result/reference
# copies the comparison tool writes next to them.
tests/reference_images/*_diff.png
tests/reference_images/*_result.png
tests/reference_images/*_reference.png
tests/reference_images/debug_*.png
tests/regression_output*/
tests/report.html
report.html
# gltf regression: the self-contained HTML report embeds every render as base64
# (hundreds of MB) and the renders/ dir is scratch -- both are regenerated by
# `python -m OpenGLContext.bin.gltf_regression`, never committed.
tests/gltf_regression/
tests/gltf_conformance_report.html
# Per-run render/diff output for the test_all_scripts visual suite; report.html
# links these by path (never embedded) and regenerates them every run.
tests/result_images/
benchmark_results/
.coverage
*.coverage.*
*.sock

/build/
