<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0">
  <head>
    <component name="ParticleSystems" level="3"/>
    <meta name="title" content="X3D particle systems"/>
    <meta name="creator" content="OpenGLContext"/>
    <meta name="license" content="BSD-3-Clause"/>
    <meta name="description" content="The scene oglc-x3d-particles opens: a brazier, a fountain, a firework, snow in the wind, a sphere shedding sparks and a glass case of bouncing gold beads, one for each emitter and physics model."/>
  </head>
  <Scene>
    <WorldInfo title="X3D particle systems" info='"The scene oglc-x3d-particles opens."'/>
    <NavigationInfo type='"EXAMINE" "ANY"'/>
    <Background skyColor="0.05 0.07 0.14 0.22 0.25 0.38" skyAngle="1.4" groundColor="0.08 0.07 0.06"/>
    <Viewpoint description="The particles" position="0 3 12" orientation="1 0 0 -0.12"/>
    <DirectionalLight global="true" direction="-0.5 -0.8 -0.4" intensity="1.4" color="1 0.95 0.9"/>

    <!-- The floor, in sandstone. -->
    <Shape>
      <Appearance>
        <PhysicalMaterial metallic="0" roughness="1">
          <ImageTexture containerField="baseTexture" url='"sandstone_base.png"'/>
          <ImageTexture containerField="metallicRoughnessTexture" url='"sandstone_mr.png"'/>
          <ImageTexture containerField="normalTexture" url='"sandstone_normal.png"'/>
        </PhysicalMaterial>
        <TextureTransform scale="4 2"/>
      </Appearance>
      <IndexedFaceSet coordIndex="0 1 2 3 -1" texCoordIndex="0 1 2 3 -1" solid="false">
        <Coordinate point="-9 0 4  9 0 4  9 0 -5  -9 0 -5"/>
        <TextureCoordinate point="0 0  1 0  1 1  0 1"/>
      </IndexedFaceSet>
    </Shape>

    <!-- A marble plinth, used under each station. -->
    <ProtoDeclare name="Plinth">
      <ProtoInterface>
        <field name="translation" type="SFVec3f" accessType="initializeOnly" value="0 0 0"/>
      </ProtoInterface>
      <ProtoBody>
        <Transform>
          <IS><connect nodeField="translation" protoField="translation"/></IS>
          <Transform translation="0 0.3 0">
            <Shape>
              <Appearance>
                <PhysicalMaterial metallic="0" roughness="0.6">
                  <ImageTexture containerField="baseTexture" url='"marble_base.png"'/>
                  <ImageTexture containerField="metallicRoughnessTexture" url='"marble_mr.png"'/>
                  <ImageTexture containerField="normalTexture" url='"marble_normal.png"'/>
                </PhysicalMaterial>
              </Appearance>
              <Box size="1.4 0.6 1.4"/>
            </Shape>
          </Transform>
        </Transform>
      </ProtoBody>
    </ProtoDeclare>

    <!-- The brazier: soft sprites thrown every way from a PointEmitter with
         no direction, rising on a ForcePhysicsModel, yellow to red to nothing
         over a second and a half. -->
    <ProtoInstance name="Plinth"><fieldValue name="translation" value="-7.5 0 0"/></ProtoInstance>
    <Transform translation="-7.5 0.6 0">
      <ParticleSystem DEF="Brazier" geometryType="SPRITE" maxParticles="300"
                      particleLifetime="1.5" lifetimeVariation="0.3" particleSize="0.35 0.35"
                      colorKey="0 0.4 1.5" texCoordKey="0">
        <Appearance><ImageTexture url='"particle_sheet.png"'/></Appearance>
        <PointEmitter containerField="emitter" direction="0 0 0" speed="0.35"
                      variation="0.5" mass="1"/>
        <ForcePhysicsModel containerField="physics" force="0 1.8 0"/>
        <ColorRGBA containerField="color" color="1 0.9 0.4 1  1 0.3 0.05 0.8  0.3 0.05 0 0"/>
        <TextureCoordinate containerField="texCoord" point="0 0  0.5 0  0.5 1  0 1"/>
      </ParticleSystem>
    </Transform>

    <!-- The fountain: a ConeEmitter throwing streaks of water up, pulled back
         down by the default ForcePhysicsModel, the Earth's gravity, which
         moves only particles with a mass. -->
    <ProtoInstance name="Plinth"><fieldValue name="translation" value="-4.5 0 0"/></ProtoInstance>
    <Transform translation="-4.5 0.6 0">
      <ParticleSystem DEF="Fountain" geometryType="LINE" maxParticles="400"
                      particleLifetime="1.1" lifetimeVariation="0.1" particleSize="0.02 0.25">
        <Appearance><Material emissiveColor="0.5 0.75 1"/></Appearance>
        <ConeEmitter containerField="emitter" direction="0 1 0" angle="0.25" speed="5.5"
                     variation="0.15" mass="1"/>
        <ForcePhysicsModel containerField="physics"/>
      </ParticleSystem>
    </Transform>

    <!-- The firework: an ExplosionEmitter's whole budget at once, falling and
         fading; f sets it off again. -->
    <ProtoInstance name="Plinth"><fieldValue name="translation" value="-1.5 0 0"/></ProtoInstance>
    <Transform translation="-1.5 3.6 0">
      <ParticleSystem DEF="Firework" geometryType="SPRITE" maxParticles="250"
                      particleLifetime="2.2" lifetimeVariation="0.3" particleSize="0.2 0.2"
                      colorKey="0 1 2.2" texCoordKey="0">
        <Appearance><ImageTexture url='"particle_sheet.png"'/></Appearance>
        <TextureCoordinate containerField="texCoord" point="0 0  0.5 0  0.5 1  0 1"/>
        <ExplosionEmitter containerField="emitter" speed="2.2" variation="0.3" mass="1"/>
        <ForcePhysicsModel containerField="physics" force="0 -1.2 0"/>
        <ColorRGBA containerField="color" color="1 1 0.8 1  0.4 0.8 1 1  0.6 0.2 1 0"/>
      </ParticleSystem>
    </Transform>

    <!-- Snow: points along a PolylineEmitter beam, drifting down in a
         WindPhysicsModel with gusts and turbulence; w switches the wind. -->
    <Transform translation="1.5 0 0">
      <Shape>
        <Appearance><Material diffuseColor="0.45 0.3 0.2"/></Appearance>
        <Extrusion spine="0 0 0  0 4.2 0" crossSection="0.06 0.06  0.06 -0.06  -0.06 -0.06  -0.06 0.06  0.06 0.06"/>
      </Shape>
      <Transform translation="0 4.2 0">
        <Shape>
          <Appearance><Material diffuseColor="0.45 0.3 0.2"/></Appearance>
          <Box size="2.4 0.08 0.08"/>
        </Shape>
      </Transform>
      <ParticleSystem DEF="Snow" geometryType="POINT" maxParticles="500"
                      particleLifetime="3" lifetimeVariation="0.2">
        <Appearance>
          <Material emissiveColor="0.95 0.97 1"/>
          <PointProperties pointSizeScaleFactor="4" pointSizeMaxValue="4"/>
        </Appearance>
        <PolylineEmitter containerField="emitter" direction="0 -1 0" speed="0.6" variation="0.3"
                         mass="0.01" surfaceArea="0.0004" coordIndex="0 1 -1">
          <Coordinate point="-1.2 4.15 0  1.2 4.15 0"/>
        </PolylineEmitter>
        <WindPhysicsModel DEF="Wind" containerField="physics" direction="1 0 0.3" speed="4"
                          gustiness="0.5" turbulence="0.3"/>
      </ParticleSystem>
    </Transform>

    <!-- The sphere: a SurfaceEmitter throwing quads off a gold sphere, along
         its normals, each a frame of the sheet in turn. -->
    <ProtoInstance name="Plinth"><fieldValue name="translation" value="4.5 0 0"/></ProtoInstance>
    <Transform translation="4.5 1.6 0">
      <Shape>
        <Appearance><PhysicalMaterial baseColor="1 0.78 0.34" metallic="0.4" roughness="0.35"/></Appearance>
        <Sphere radius="0.6"/>
      </Shape>
      <ParticleSystem DEF="Sparks" geometryType="QUAD" maxParticles="200"
                      particleLifetime="1.2" lifetimeVariation="0.25" particleSize="0.18 0.18"
                      texCoordKey="0 0.6">
        <Appearance>
          <Material diffuseColor="0 0 0" emissiveColor="1 0.85 0.5"/>
          <ImageTexture url='"particle_sheet.png"'/>
        </Appearance>
        <SurfaceEmitter containerField="emitter" speed="0.8" variation="0.3">
          <Sphere containerField="surface" radius="0.62"/>
        </SurfaceEmitter>
        <TextureCoordinate containerField="texCoord" point="0 0  0.5 0  0.5 1  0 1  0.5 0  1 0  1 1  0.5 1"/>
      </ParticleSystem>
    </Transform>

    <!-- The case: gold beads made inside a VolumeEmitter, bouncing off the
         inside of the same box with a BoundedPhysicsModel, under gravity. -->
    <ProtoInstance name="Plinth"><fieldValue name="translation" value="7.5 0 0"/></ProtoInstance>
    <Transform translation="7.5 1.4 0">
      <Shape>
        <Appearance><PhysicalMaterial baseColor="0.8 0.9 1" metallic="0" roughness="0.05" transparency="0.82"/></Appearance>
        <Box size="1.6 1.6 1.6"/>
      </Shape>
      <ParticleSystem DEF="Beads" geometryType="GEOMETRY" maxParticles="60"
                      particleLifetime="12" lifetimeVariation="0.2">
        <Appearance><PhysicalMaterial baseColor="1 0.78 0.34" metallic="0.4" roughness="0.3"/></Appearance>
        <Sphere radius="0.06"/>
        <VolumeEmitter containerField="emitter" speed="1.5" variation="0.5" mass="1"
                       direction="0 0 0"
                       coordIndex="0 3 2 1 -1  4 5 6 7 -1  0 1 5 4 -1  2 3 7 6 -1  1 2 6 5 -1  0 4 7 3 -1">
          <Coordinate point="-0.7 -0.7 -0.7  0.7 -0.7 -0.7  0.7 0.7 -0.7  -0.7 0.7 -0.7
                             -0.7 -0.7 0.7  0.7 -0.7 0.7  0.7 0.7 0.7  -0.7 0.7 0.7"/>
        </VolumeEmitter>
        <ForcePhysicsModel containerField="physics" force="0 -3 0"/>
        <BoundedPhysicsModel containerField="physics">
          <Box size="1.5 1.5 1.5"/>
        </BoundedPhysicsModel>
      </ParticleSystem>
    </Transform>
  </Scene>
</X3D>
