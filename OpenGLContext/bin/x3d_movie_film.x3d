<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0">
  <head>
    <meta name="title" content="X3D movie: the film"/>
    <meta name="creator" content="OpenGLContext"/>
    <meta name="license" content="BSD-3-Clause"/>
    <meta name="description" content="The film oglc-x3d-movie records and plays: a dial whose hand turns once, a bar that fills, a copper-coloured cube turning and a backdrop changing colour, over four seconds."/>
  </head>
  <Scene>
    <WorldInfo title="X3D movie: the film"/>
    <NavigationInfo type='"NONE"' headlight="false"/>
    <Background skyColor="0.05 0.06 0.10"/>
    <Viewpoint description="The film" position="0 0 9" fieldOfView="0.7"/>
    <DirectionalLight direction="-0.3 -0.4 -1" intensity="1.4"/>

    <!-- One run of the film: everything below is one cycle of this sensor. -->
    <TimeSensor DEF="Run" cycleInterval="4" loop="true"/>

    <!-- The backdrop, blue to purple to orange and back to blue. -->
    <Transform translation="0 0 -1">
      <Shape>
        <Appearance>
          <Material DEF="Backdrop" diffuseColor="0.10 0.25 0.70"/>
        </Appearance>
        <Box size="14 8 0.1"/>
      </Shape>
    </Transform>
    <ColorInterpolator DEF="Shades" key="0 0.33 0.66 1"
        keyValue="0.10 0.25 0.70  0.50 0.15 0.60  0.85 0.45 0.10  0.10 0.25 0.70"/>

    <!-- The dial: a white face and a red hand turning once clockwise. -->
    <Transform translation="-1.6 0.25 0" rotation="1 0 0 1.5708">
      <Shape>
        <Appearance><Material diffuseColor="0.92 0.92 0.88"/></Appearance>
        <Cylinder radius="1.3" height="0.1"/>
      </Shape>
    </Transform>
    <Transform DEF="Hand" translation="-1.6 0.25 0.12">
      <Transform translation="0 0.55 0">
        <Shape>
          <Appearance><Material diffuseColor="0.85 0.05 0.05"/></Appearance>
          <Box size="0.14 1.1 0.06"/>
        </Shape>
      </Transform>
    </Transform>
    <OrientationInterpolator DEF="Turn" key="0 0.25 0.5 0.75 1"
        keyValue="0 0 1 0  0 0 1 -1.5708  0 0 1 -3.1416  0 0 1 -4.7124  0 0 1 -6.2832"/>

    <!-- The bar along the foot, filling from the left. -->
    <Transform DEF="Bar" translation="-3.5 -1.75 0.1" scale="0.001 1 1">
      <Transform translation="3.5 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.95 0.80 0.15"/></Appearance>
          <Box size="7 0.3 0.1"/>
        </Shape>
      </Transform>
    </Transform>
    <PositionInterpolator DEF="Fill" key="0 1" keyValue="0.001 1 1  1 1 1"/>

    <!-- A copper-coloured cube turning once. -->
    <Transform DEF="Cube" translation="1.9 0.25 0.5">
      <Shape>
        <Appearance>
          <PhysicalMaterial baseColor="0.90 0.50 0.30" metallic="0" roughness="0.45"/>
        </Appearance>
        <Box size="1.4 1.4 1.4"/>
      </Shape>
    </Transform>
    <OrientationInterpolator DEF="Spin" key="0 0.5 1"
        keyValue="0.4 1 0.2 0  0.4 1 0.2 3.1416  0.4 1 0.2 6.2832"/>

    <ROUTE fromNode="Run" fromField="fraction_changed" toNode="Shades" toField="set_fraction"/>
    <ROUTE fromNode="Shades" fromField="value_changed" toNode="Backdrop" toField="diffuseColor"/>
    <ROUTE fromNode="Run" fromField="fraction_changed" toNode="Turn" toField="set_fraction"/>
    <ROUTE fromNode="Turn" fromField="value_changed" toNode="Hand" toField="rotation"/>
    <ROUTE fromNode="Run" fromField="fraction_changed" toNode="Fill" toField="set_fraction"/>
    <ROUTE fromNode="Fill" fromField="value_changed" toNode="Bar" toField="scale"/>
    <ROUTE fromNode="Run" fromField="fraction_changed" toNode="Spin" toField="set_fraction"/>
    <ROUTE fromNode="Spin" fromField="value_changed" toNode="Cube" toField="rotation"/>
  </Scene>
</X3D>
