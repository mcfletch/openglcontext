<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0">
  <head>
    <component name="Shape" level="4"/>
    <component name="Lighting" level="3"/>
    <meta name="title" content="X3D gallery"/>
    <meta name="creator" content="OpenGLContext"/>
    <meta name="license" content="BSD-3-Clause"/>
    <meta name="description" content="The scene oglc-x3d opens: PhysicalMaterial metals, stone and brick, a scoped lamp, shadows, X3D's triangle sets, an ElevationGrid and an Inlined glTF model."/>
  </head>
  <Scene>
    <WorldInfo title="X3D gallery" info='"The scene oglc-x3d opens."'/>
    <NavigationInfo headlight="false" type='"EXAMINE" "ANY"'/>
    <Background skyColor="0.38 0.52 0.72 0.72 0.80 0.90" skyAngle="1.4" groundColor="0.30 0.27 0.22"/>
    <Viewpoint DEF="Overview" description="The gallery" position="0 3.2 11" orientation="1 0 0 -0.22"/>
    <Viewpoint DEF="AlcoveView" description="The alcove" position="-3.4 1.6 1.4" orientation="0 1 0 0.35"/>
    <Viewpoint DEF="VaseView" description="The vase" position="3.6 1.6 2.4" orientation="0 1 0 -0.3"/>

    <!-- The sun: lights everything, and casts shadows. -->
    <DirectionalLight DEF="Sun" global="true" shadows="true" shadowIntensity="0.85"
                      direction="-0.9 -0.75 -0.3" intensity="2.4" color="1 0.96 0.9"/>

    <!-- The floor: checkered marble, its maps tiled four times by a transform. -->
    <Shape>
      <Appearance>
        <PhysicalMaterial metallic="0" roughness="1">
          <ImageTexture containerField="baseTexture" url='"marble_base.png"'/>
          <ImageTexture containerField="metallicRoughnessTexture" url='"marble_mr.png"'/>
          <ImageTexture containerField="normalTexture" url='"marble_normal.png"'/>
        </PhysicalMaterial>
        <TextureTransform scale="4 4"/>
      </Appearance>
      <IndexedTriangleSet index="0 1 2 0 2 3" solid="true">
        <Coordinate point="-6 0 6 6 0 6 6 0 -6 -6 0 -6"/>
        <TextureCoordinate point="0 0 1 0 1 1 0 1"/>
      </IndexedTriangleSet>
    </Shape>

    <!-- The back wall: brick, read through TEXCOORD_0 by name. -->
    <Shape>
      <Appearance>
        <PhysicalMaterial metallic="0" roughness="1" baseTextureMapping="TEXCOORD_0"
                          metallicRoughnessTextureMapping="TEXCOORD_0" normalTextureMapping="TEXCOORD_0">
          <ImageTexture containerField="baseTexture" url='"brick_base.png"'/>
          <ImageTexture containerField="metallicRoughnessTexture" url='"brick_mr.png"'/>
          <ImageTexture containerField="normalTexture" url='"brick_normal.png"'/>
        </PhysicalMaterial>
      </Appearance>
      <IndexedTriangleStripSet index="0 1 3 2" solid="true">
        <Coordinate point="-6 0 -6 6 0 -6 6 4 -6 -6 4 -6"/>
        <TextureCoordinate point="0 0 4 0 4 1.5 0 1.5"/>
      </IndexedTriangleStripSet>
    </Shape>

    <!-- A medallion on the wall: a fan of coloured triangles and its outline. -->
    <Transform DEF="Medallion" translation="0 2.4 -5.95">
      <Shape>
        <Appearance><Material diffuseColor="1 1 1"/></Appearance>
        <TriangleFanSet fanCount="12" solid="false">
          <Coordinate point="0 0 0 0.9 0 0 0.73 0.53 0 0.28 0.86 0 -0.28 0.86 0 -0.73 0.53 0 -0.9 0 0 -0.73 -0.53 0 -0.28 -0.86 0 0.28 -0.86 0 0.73 -0.53 0 0.9 0 0"/>
          <ColorRGBA color="1 0.9 0.6 1 0.8 0.3 0.1 1 0.85 0.6 0.15 1 0.8 0.3 0.1 1 0.85 0.6 0.15 1 0.8 0.3 0.1 1 0.85 0.6 0.15 1 0.8 0.3 0.1 1 0.85 0.6 0.15 1 0.8 0.3 0.1 1 0.85 0.6 0.15 1 0.8 0.3 0.1 1"/>
        </TriangleFanSet>
      </Shape>
      <Shape>
        <Appearance><Material emissiveColor="0.25 0.18 0.05"/></Appearance>
        <LineSet vertexCount="11">
          <Coordinate point="0.9 0 0.01 0.73 0.53 0.01 0.28 0.86 0.01 -0.28 0.86 0.01 -0.73 0.53 0.01 -0.9 0 0.01 -0.73 -0.53 0.01 -0.28 -0.86 0.01 0.28 -0.86 0.01 0.73 -0.53 0.01 0.9 0 0.01"/>
        </LineSet>
      </Shape>
    </Transform>

    <!-- Three spheres on sandstone plinths: gold, copper and steel. -->
    <Transform translation="-1.6 0 0">
      <Transform translation="0 0.45 0">
      <Shape>
        <Appearance><Material DEF="Sandstone" shininess="0.1">
          <ImageTexture containerField="diffuseTexture" url='"sandstone_base.png"'/>
          <ImageTexture containerField="normalTexture" url='"sandstone_normal.png"'/>
        </Material></Appearance>
        <Cylinder radius="0.45" height="0.9"/>
      </Shape>
      </Transform>
      <Transform translation="0 1.3 0">
        <Shape><Appearance><PhysicalMaterial baseColor="1 0.766 0.336" metallic="1" roughness="0.2"/></Appearance><Sphere radius="0.4"/></Shape>
      </Transform>
    </Transform>
    <Transform translation="0 0 0">
      <Transform translation="0 0.45 0"><Shape><Appearance><Material USE="Sandstone"/></Appearance><Cylinder radius="0.45" height="0.9"/></Shape></Transform>
      <Transform translation="0 1.3 0">
        <Shape><Appearance><PhysicalMaterial baseColor="0.955 0.638 0.538" metallic="1" roughness="0.35"/></Appearance><Sphere radius="0.4"/></Shape>
      </Transform>
    </Transform>
    <Transform translation="1.6 0 0">
      <Transform translation="0 0.45 0"><Shape><Appearance><Material USE="Sandstone"/></Appearance><Cylinder radius="0.45" height="0.9"/></Shape></Transform>
      <Transform translation="0 1.3 0">
        <Shape><Appearance><PhysicalMaterial baseColor="0.56 0.57 0.58" metallic="1" roughness="0.5"/></Appearance><Sphere radius="0.4"/></Shape>
      </Transform>
    </Transform>

    <!-- The alcove: a lamp scoped to it lights the bronze ball inside and nothing else. -->
    <Transform DEF="Alcove" translation="-4.2 0.6 -2.5">
      <DirectionalLight DEF="AlcoveLamp" global="false" direction="0.3 -0.6 -1" intensity="3" color="1 0.6 0.3"/>
      <Shape>
        <Appearance><PhysicalMaterial baseColor="0.8 0.55 0.3" metallic="1" roughness="0.3"/></Appearance>
        <Sphere radius="0.6"/>
      </Shape>
      <Shape>
        <Appearance><Material diffuseColor="0.6 0.58 0.55"/></Appearance>
        <TriangleSet solid="false">
          <Coordinate point="-1.2 -0.6 -1 1.2 -0.6 -1 1.2 1.8 -1 -1.2 -0.6 -1 1.2 1.8 -1 -1.2 1.8 -1"/>
        </TriangleSet>
      </Shape>
    </Transform>

    <!-- A mound of sandstone: an ElevationGrid smoothed within its crease angle. -->
    <Transform translation="3 0.001 -3">
      <Shape>
        <Appearance><Material USE="Sandstone"/></Appearance>
        <ElevationGrid xDimension="5" zDimension="5" xSpacing="0.5" zSpacing="0.5" creaseAngle="1.2"
                       height="0 0 0 0 0 0 0.25 0.4 0.25 0 0 0.4 0.7 0.4 0 0 0.25 0.4 0.25 0 0 0 0 0 0"/>
      </Shape>
    </Transform>

    <!-- A gold vase, a glTF model written beside this document. -->
    <Transform translation="3.4 0 0.6" rotation="1 0 0 -1.5708">
      <Inline url='"vase.glb"'/>
    </Transform>
  </Scene>
</X3D>
