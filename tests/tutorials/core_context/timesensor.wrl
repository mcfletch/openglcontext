#VRML V2.0 utf8

DEF Back SimpleBackground { color 0,0,1 }

DEF LightOrient OrientationInterpolator {
	key [ 0 .333333 .666666 1.0 ]
	keyValue [
 		0 1 0 0 
		0 1 0 2.094
		0 1 0 4.189
		0 1 0 0
	]
}

DEF LightPosition Transform {
  children [
    DEF Omni01 PointLight {
      intensity 1
      ambientIntensity .5
      color 1 1 1
      location 1 3 0
      on TRUE
      radius 11.1
    }
  ]
}
NavigationInfo { 
  headlight FALSE
  type "FLY"
}
DEF Timer TimeSensor {
	cycleInterval 5
	enabled TRUE
	loop TRUE
}
DEF OI OrientationInterpolator {
	key [ 0 .333333 .666666 1.0 ]
	keyValue [
 		0 0 1 0 
		0 0 1 2.094
		0 0 1 4.189
		0 0 1 0
	]
}
DEF Box01 Transform {
	translation -2 0 0
  children [
    DEF TheBox Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.525 0.431 0.0314
        }
				texture ImageTexture {
				 url [ "luminance_alpha.png"]
				}
      }
      geometry Box { size 4 0.5 4 }
    }
  ]
}
DEF Box02 Transform {
	translation 2,0,0
  children [
		USE TheBox
  ]
}
ROUTE Box01.rotation TO Box02.rotation
ROUTE Timer.fraction_changed TO OI.set_fraction
ROUTE OI.value_changed TO Box01.set_rotation

ROUTE LightOrient.value_changed TO LightPosition.set_rotation