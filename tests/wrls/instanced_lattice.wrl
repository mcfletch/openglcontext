#VRML V2.0 utf8
# NaCl rock-salt lattice -- demonstrates AUTOMATIC Sphere instancing.
# 216 atoms; the two atom Shapes are DEF/USE-shared, so the core (VRML97)
# pass collapses each element into a single glDrawElementsInstanced.
# View with the core profile, e.g.  OPENGLCONTEXT_PROFILE=core <viewer> instanced_lattice.wrl
Transform { children [
  NavigationInfo { type "EXAMINE" }
  DirectionalLight { direction -0.3 -0.4 -1.0 intensity 1.2 }
  DEF Na Shape { appearance Appearance { material Material { diffuseColor 0.55 0.3 0.95 } } geometry Sphere { radius 0.30 } }
  DEF Cl Shape { appearance Appearance { material Material { diffuseColor 0.30 0.85 0.45 } } geometry Sphere { radius 0.52 } }
