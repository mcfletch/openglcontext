#VRML V2.0 utf8
# META "title" "Sound"
# META "description" "Plays a source from a place in the world: location and direction place it, minFront and maxFront bound the ellipsoid it is heard in, and it is louder close up and in front."
# META "sample:interactive" "true"

Viewpoint {
  orientation -0.5557 0.821 0.1312 0.56
  position 3 2.5 6
}
Transform {
  translation 0 0.5 0
  children [
    Sound {
      maxBack 6
      maxFront 12
      minFront 2
      source AudioClip {
        loop TRUE
        url [ "assets/tone.wav" ]
      }
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.85 0.7 0.2
        }
      }
      geometry Sphere {
        radius 0.4
      }
    }
  ]
}
Transform {
  translation 0 -1.1 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.6 0.55 0.5
        }
      }
      geometry Box {
        size 10 0.2 10
      }
    }
  ]
}
