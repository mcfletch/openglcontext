#VRML V2.0 utf8
# META "title" "TouchSensor"
# META "description" "Senses a pointer over and on the shapes in its group: isOver is true while the pointer is on them, isActive while the button is down, and touchTime is the time of a click."
# META "sample:interactive" "true"

Viewpoint {
  orientation -0.6008 0.7867 0.1418 0.583
  position 1.8 1.5 3.6
}
Group {
  children [
    DEF Button TouchSensor { }
    DEF Block Transform {
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.45 0.2
            }
          }
          geometry Box {
            size 1.6 1.6 1.6
          }
        }
      ]
    }
  ]
}
DEF Clock TimeSensor { }
DEF Turn OrientationInterpolator {
  key [ 0 0.25 0.5 0.75 1 ]
  keyValue [ 0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832 ]
}
ROUTE Button.touchTime TO Clock.set_startTime
ROUTE Clock.fraction_changed TO Turn.set_fraction
ROUTE Turn.value_changed TO Block.set_rotation
