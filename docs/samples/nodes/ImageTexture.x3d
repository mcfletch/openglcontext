<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="ImageTexture"/>
    <meta name="description" content="An image from a url laid over a surface; repeatS and repeatT choose whether coordinates beyond the image repeat it or stretch its edge."/>
  </head>
  <Scene>
    <Viewpoint position="0 0.3 7" orientation="-1 -0 -0 0.0428"/>
    <!-- Repeating: the default. -->
    <Transform translation="-1.7 0 0">
      <Shape>
        <Appearance><ImageTexture url='"assets/checker.png"' repeatS="true" repeatT="true"/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 3 -1" solid="false">
          <Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/>
          <TextureCoordinate point="-0.5 -0.5, 1.5 -0.5, 1.5 1.5, -0.5 1.5"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <!-- Not repeating: outside the image the edge pixels are stretched. -->
    <Transform translation="1.7 0 0">
      <Shape>
        <Appearance><ImageTexture url='"assets/checker.png"' repeatS="false" repeatT="false"/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 3 -1" solid="false">
          <Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/>
          <TextureCoordinate point="-0.5 -0.5, 1.5 -0.5, 1.5 1.5, -0.5 1.5"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
  </Scene>
</X3D>
