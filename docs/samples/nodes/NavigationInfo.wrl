#VRML V2.0 utf8
# META "title" "NavigationInfo"
# META "description" "How the viewer moves and what it carries: type lists the ways of navigating in order of preference, speed and avatarSize set the pace and the body, and headlight the lamp on the viewer."
# META "sample:interactive" "true"

Viewpoint {
  orientation 0 1 0 0
  position 0 1.6 7
}
NavigationInfo {
  speed 2
  type [ "WALK" "FLY" "ANY" ]
  visibilityLimit 40
}
Transform {
  translation 0 -1.1 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.6 0.55 0.5
        }
      }
      geometry Box {
        size 10 0.2 10
      }
    }
  ]
}
Transform {
  translation -2.5 0 -2
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.4 0.3
        }
      }
      geometry Box {
        size 1.4 1.4 1.4
      }
    }
  ]
}
Transform {
  translation 0 0 -4
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.3 0.55 0.85
        }
      }
      geometry Cone {
        bottomRadius 0.9
        height 1.8
      }
    }
  ]
}
Transform {
  translation 2.5 0 -2
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.4 0.75 0.4
        }
      }
      geometry Cylinder {
        height 1.6
        radius 0.7
      }
    }
  ]
