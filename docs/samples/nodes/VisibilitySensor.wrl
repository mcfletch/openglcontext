#VRML V2.0 utf8
# META "title" "VisibilitySensor"
# META "description" "Senses whether a box is in view: isActive is true while any part of the box set by center and size is visible to the viewer, with enterTime and exitTime."
# META "sample:interactive" "true"

Viewpoint {
  orientation -1 -0 -0 0.3709
  position 0 3.5 9
}
Shape {
  appearance Appearance {
    material Material {
      emissiveColor 0.5 0.7 0.5
    }
  }
  geometry IndexedLineSet {
    coordIndex [ 0 1 2 3 0 -1 4 5 6 7 4 -1 0 4 -1 1 5 -1 2 6 -1 3 7 -1 ]
    coord Coordinate {
      point [ -1.5 -1 -1.5, 1.5 -1 -1.5, 1.5 -1 1.5, -1.5 -1 1.5, -1.5 2 -1.5, 1.5 2 -1.5, 1.5 2 1.5, -1.5 2 1.5 ]
    }
  }
}
DEF Seen VisibilitySensor {
  center 0 0.5 0
  size 3 3 3
}
DEF Spinner Transform {
  translation 0 0.5 0
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.85 0.4 0.25
        }
      }
      geometry Box {
        size 1.6 1.6 1.6
      }
    }
  ]
}
DEF Clock TimeSensor { }
DEF Turn OrientationInterpolator {
  key [ 0 0.25 0.5 0.75 1 ]
  keyValue [ 0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832 ]
}
ROUTE Seen.enterTime TO Clock.set_startTime
ROUTE Clock.fraction_changed TO Turn.set_fraction
ROUTE Turn.value_changed TO Spinner.set_rotation
