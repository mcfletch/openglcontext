#VRML V2.0 utf8
# META "title" "Anchor"
# META "description" "A group that loads another document when clicked: url names it, description is what a browser shows over it."
# META "sample:interactive" "true"

Viewpoint {
  orientation -0.6008 0.7867 0.1418 0.583
  position 1.8 1.5 3.6
}
Anchor {
  description "Open the Box sample"
  url [ "Box.x3d" ]
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.2 0.55 0.8
        }
      }
      geometry Box {
        size 1.5 1.5 1.5
      }
    }
  ]
}
