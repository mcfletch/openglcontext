<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="TextureCoordinate"/>
    <meta name="description" content="Where each point of a geometry falls on its texture, from 0 to 1 across the image; coordinates beyond 1 repeat the image."/>
  </head>
  <Scene>
    <Viewpoint position="0 0.3 7" orientation="-1 -0 -0 0.0428"/>
    <!-- The image once, edge to edge. -->
    <Transform translation="-1.7 0 0">
      <Shape>
        <Appearance><ImageTexture url='"assets/checker.png"'/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 3 -1" solid="false">
          <Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/>
          <TextureCoordinate point="0 0, 1 0, 1 1, 0 1"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
    <!-- Coordinates to 2: the image repeats twice each way. -->
    <Transform translation="1.7 0 0">
      <Shape>
        <Appearance><ImageTexture url='"assets/checker.png"'/></Appearance>
        <IndexedFaceSet coordIndex="0 1 2 3 -1" solid="false">
          <Coordinate point="-1 -1 0, 1 -1 0, 1 1 0, -1 1 0"/>
          <TextureCoordinate point="0 0, 2 0, 2 2, 0 2"/>
        </IndexedFaceSet>
      </Shape>
    </Transform>
  </Scene>
</X3D>
