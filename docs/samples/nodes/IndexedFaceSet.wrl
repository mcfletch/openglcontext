#VRML V2.0 utf8
# META "title" "IndexedFaceSet"
# META "description" "A surface built from faces that index a list of points: coordIndex names the points of each face, closed by -1, in counter-clockwise order seen from outside."

Viewpoint {
  orientation -0.5301 0.8337 0.1544 0.6721
  position 2.8 2.6 4.4
}
Shape {
  appearance Appearance {
    material Material {
      diffuseColor 0.8 0.6 0.25
    }
  }
  geometry IndexedFaceSet {
    coordIndex [ 0 3 2 1 -1 3 2 4 -1 2 1 4 -1 1 0 4 -1 0 3 4 -1 ]
    coord Coordinate {
      point [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1, 0 1.6 0 ]
    }
  }
}
