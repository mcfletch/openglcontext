#VRML V2.0 utf8
# META "title" "PositionInterpolator"
# META "description" "Moves a position along the keyValue points as set_fraction passes the key fractions, in a straight line between each pair."
# META "sample:frames" "59"

Viewpoint {
  orientation -1 -0 -0 0.025
  position 0 1 8
}
DEF Clock TimeSensor {
  cycleInterval 4
  loop TRUE
}
DEF Path PositionInterpolator {
  key [ 0 0.5 1 ]
  keyValue [ -3 0 0, 0 2 0, 3 0 0 ]
}
Shape {
  appearance Appearance {
    material Material {
      emissiveColor 0.6 0.6 0.6
    }
  }
  geometry IndexedLineSet {
    coordIndex [ 0 1 2 -1 ]
    coord Coordinate {
      point [ -3 0 0, 0 2 0, 3 0 0 ]
    }
  }
}
DEF Ball Transform {
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.85 0.4 0.25
          shininess 0.5
          specularColor 0.8 0.8 0.8
        }
      }
      geometry Sphere {
        radius 0.4
      }
    }
  ]
}
ROUTE Clock.fraction_changed TO Path.set_fraction
ROUTE Path.value_changed TO Ball.set_translation
