<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="TimeSensor"/>
    <meta name="description" content="A clock that sends fraction_changed from 0 to 1 over cycleInterval seconds, from startTime, repeating where loop is true; routed to an interpolator it drives any animation."/>
    <meta name="sample:frames" content="59"/>
  </head>
  <Scene>
    <Viewpoint position="0 0.5 6.5" orientation="-1 -0 -0 0.0768"/>
    <!-- Four seconds a turn, started at time 0 and looping. The reference render is 1 second in: a quarter turn. -->
    <TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
    <!-- A quarter turn at each key. A key a half turn from its neighbour would leave the interpolator free to go round either way. -->
    <OrientationInterpolator DEF="Turn" key="0 0.25 0.5 0.75 1"
        keyValue="0 0 1 0, 0 0 1 1.5708, 0 0 1 3.1416, 0 0 1 4.7124, 0 0 1 6.2832"/>
    <Transform DEF="Rotor">
      <Shape>
        <Appearance><Material diffuseColor="0.8 0.35 0.3"/></Appearance>
        <Box size="2.4 0.25 0.25"/>
      </Shape>
      <Transform translation="1.2 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.9 0.85 0.3"/></Appearance>
          <Sphere radius="0.35"/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Turn" toField="set_fraction"/>
    <ROUTE fromNode="Turn" fromField="value_changed" toNode="Rotor" toField="set_rotation"/>
  </Scene>
</X3D>
