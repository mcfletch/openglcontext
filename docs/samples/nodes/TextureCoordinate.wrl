#VRML V2.0 utf8
# META "title" "TextureCoordinate"
# META "description" "Where each point of a geometry falls on its texture, from 0 to 1 across the image; coordinates beyond 1 repeat the image."

Viewpoint {
  orientation -1 -0 -0 0.0428
  position 0 0.3 7
}
Transform {
  translation -1.7 0 0
  children [
    Shape {
      appearance Appearance {
        texture ImageTexture {
          url [ "assets/checker.png" ]
        }
      }
      geometry IndexedFaceSet {
        coordIndex [ 0 1 2 3 -1 ]
        solid FALSE
        coord Coordinate {
          point [ -1 -1 0, 1 -1 0, 1 1 0, -1 1 0 ]
        }
        texCoord TextureCoordinate {
          point [ 0 0, 1 0, 1 1, 0 1 ]
        }
      }
    }
  ]
}
Transform {
  translation 1.7 0 0
  children [
    Shape {
      appearance Appearance {
        texture ImageTexture {
          url [ "assets/checker.png" ]
        }
      }
      geometry IndexedFaceSet {
        coordIndex [ 0 1 2 3 -1 ]
        solid FALSE
        coord Coordinate {
          point [ -1 -1 0, 1 -1 0, 1 1 0, -1 1 0 ]
        }
        texCoord TextureCoordinate {
          point [ 0 0, 2 0, 2 2, 0 2 ]
        }
      }
    }
  ]
}
