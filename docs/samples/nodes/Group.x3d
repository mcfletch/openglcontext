<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="Group"/>
    <meta name="description" content="Holds children and gives them no transform of its own; a DEF on the group names the whole set so it can be used again."/>
  </head>
  <Scene>
    <Viewpoint position="0 2.2 8.5" orientation="-1 -0 -0 0.2533"/>
    <!-- A group of two shapes, named Pair so it can be used again. -->
    <Group DEF="Pair">
      <Transform translation="-1.2 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.85 0.3 0.25"/></Appearance>
          <Box size="1.4 1.4 1.4"/>
        </Shape>
      </Transform>
      <Transform translation="1.2 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.25 0.5 0.85"/></Appearance>
          <Sphere radius="0.7"/>
        </Shape>
      </Transform>
    </Group>
    <!-- The same group, used again two units lower. -->
    <Transform translation="0 -2 0">
      <Group USE="Pair"/>
    </Transform>
  </Scene>
</X3D>
