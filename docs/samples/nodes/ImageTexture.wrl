#VRML V2.0 utf8
# META "title" "ImageTexture"
# META "description" "An image from a url laid over a surface; repeatS and repeatT choose whether coordinates beyond the image repeat it or stretch its edge."

Viewpoint {
  orientation -1 -0 -0 0.0428
  position 0 0.3 7
}
Transform {
  translation -1.7 0 0
  children [
    Shape {
      appearance Appearance {
        texture ImageTexture {
          url [ "assets/checker.png" ]
        }
      }
      geometry IndexedFaceSet {
        coordIndex [ 0 1 2 3 -1 ]
        solid FALSE
        coord Coordinate {
          point [ -1 -1 0, 1 -1 0, 1 1 0, -1 1 0 ]
        }
        texCoord TextureCoordinate {
          point [ -0.5 -0.5, 1.5 -0.5, 1.5 1.5, -0.5 1.5 ]
        }
      }
    }
  ]
}
Transform {
  translation 1.7 0 0
  children [
    Shape {
      appearance Appearance {
        texture ImageTexture {
          repeatS FALSE
          repeatT FALSE
          url [ "assets/checker.png" ]
        }
      }
      geometry IndexedFaceSet {
        coordIndex [ 0 1 2 3 -1 ]
        solid FALSE
        coord Coordinate {
          point [ -1 -1 0, 1 -1 0, 1 1 0, -1 1 0 ]
        }
        texCoord TextureCoordinate {
          point [ -0.5 -0.5, 1.5 -0.5, 1.5 1.5, -0.5 1.5 ]
        }
      }
    }
  ]
}
