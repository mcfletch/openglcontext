<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="Viewpoint"/>
    <meta name="description" content="A place to look from: position and orientation place the viewer, fieldOfView sets the width of the view, and description names it in a browser menu."/>
    <meta name="sample:interactive" content="true"/>
  </head>
  <Scene>
    <!-- The first viewpoint is the one a document opens on. -->
    <Viewpoint DEF="Front" description="Front, from the side" position="3 1.5 5" orientation="-0.4129 0.9036 0.1144 0.5949" fieldOfView="0.8"/>
    <Viewpoint DEF="Above" description="From above" position="0 8 0.01" orientation="-1 0 0 1.5696"/>
    <Shape>
      <Appearance><Material diffuseColor="0.8 0.5 0.2"/></Appearance>
      <Box size="2 1 1"/>
    </Shape>
    <Transform translation="0 -0.75 0">
      <Shape>
        <Appearance><Material diffuseColor="0.3 0.6 0.4"/></Appearance>
        <Box size="6 0.5 6"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
