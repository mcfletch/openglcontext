#VRML V2.0 utf8
# META "title" "TimeSensor"
# META "description" "A clock that sends fraction_changed from 0 to 1 over cycleInterval seconds, from startTime, repeating where loop is true; routed to an interpolator it drives any animation."
# META "sample:frames" "59"

Viewpoint {
  orientation -1 -0 -0 0.0768
  position 0 0.5 6.5
}
DEF Clock TimeSensor {
  cycleInterval 4
  loop TRUE
}
DEF Turn OrientationInterpolator {
  key [ 0 0.25 0.5 0.75 1 ]
  keyValue [ 0 0 1 0, 0 0 1 1.5708, 0 0 1 3.1416, 0 0 1 4.7124, 0 0 1 6.2832 ]
}
DEF Rotor Transform {
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.35 0.3
        }
      }
      geometry Box {
        size 2.4 0.25 0.25
      }
    }
    Transform {
      translation 1.2 0 0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.9 0.85 0.3
            }
          }
          geometry Sphere {
            radius 0.35
          }
        }
      ]
    }
  ]
}
ROUTE Clock.fraction_changed TO Turn.set_fraction
ROUTE Turn.value_changed TO Rotor.set_rotation
