<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="Sound"/>
    <meta name="description" content="Plays a source from a place in the world: location and direction place it, minFront and maxFront bound the ellipsoid it is heard in, and it is louder close up and in front."/>
    <meta name="sample:interactive" content="true"/>
  </head>
  <Scene>
    <Viewpoint position="3 2.5 6" orientation="-0.5557 0.821 0.1312 0.56"/>
    <!-- A speaker: the sphere marks the location of the Sound. -->
    <Transform translation="0 0.5 0">
      <Sound location="0 0 0" direction="0 0 1" intensity="1" minFront="2" minBack="1" maxFront="12" maxBack="6" spatialize="true">
        <AudioClip url='"assets/tone.wav"' loop="true"/>
      </Sound>
      <Shape>
        <Appearance><Material diffuseColor="0.85 0.7 0.2"/></Appearance>
        <Sphere radius="0.4"/>
      </Shape>
    </Transform>
    <Transform translation="0 -1.1 0">
      <Shape>
        <Appearance><Material diffuseColor="0.6 0.55 0.5"/></Appearance>
        <Box size="10 0.2 10"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
