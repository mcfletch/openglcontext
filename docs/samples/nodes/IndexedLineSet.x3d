<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="IndexedLineSet"/>
    <meta name="description" content="Lines through points that index a list: each run in coordIndex, closed by -1, is one polyline; lines are drawn unlit in the emissive colour or in their own Color."/>
  </head>
  <Scene>
    <Viewpoint position="2.6 2.2 4.2" orientation="-0.5017 0.8532 0.1427 0.6437"/>
    <Shape>
      <Appearance>
        <Material emissiveColor="1 1 1"/>
      </Appearance>
      <!-- The base square, then an edge from each corner to the apex. -->
      <IndexedLineSet coordIndex="0 1 2 3 0 -1, 0 4 -1, 1 4 -1, 2 4 -1, 3 4 -1" colorPerVertex="false">
        <Coordinate point="-1 0 -1, 1 0 -1, 1 0 1, -1 0 1, 0 1.6 0"/>
        <Color color="1 0.3 0.3, 0.3 1 0.3, 0.3 0.5 1, 1 0.9 0.2, 0.9 0.4 1"/>
      </IndexedLineSet>
    </Shape>
  </Scene>
</X3D>
