<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="VisibilitySensor"/>
    <meta name="description" content="Senses whether a box is in view: isActive is true while any part of the box set by center and size is visible to the viewer, with enterTime and exitTime."/>
    <meta name="sample:interactive" content="true"/>
  </head>
  <Scene>
    <Viewpoint position="0 3.5 9" orientation="-1 -0 -0 0.3709"/>
    <!-- Looking at the box starts a one second spin. The sensor's region is drawn as lines. -->
    <Shape>
      <Appearance><Material emissiveColor="0.5 0.7 0.5"/></Appearance>
      <IndexedLineSet coordIndex="0 1 2 3 0 -1, 4 5 6 7 4 -1, 0 4 -1, 1 5 -1, 2 6 -1, 3 7 -1">
        <Coordinate point="-1.5 -1 -1.5, 1.5 -1 -1.5, 1.5 -1 1.5, -1.5 -1 1.5, -1.5 2 -1.5, 1.5 2 -1.5, 1.5 2 1.5, -1.5 2 1.5"/>
      </IndexedLineSet>
    </Shape>
    <VisibilitySensor DEF="Seen" center="0 0.5 0" size="3 3 3"/>
    <Transform DEF="Spinner" translation="0 0.5 0">
      <Shape>
        <Appearance><Material diffuseColor="0.85 0.4 0.25"/></Appearance>
        <Box size="1.6 1.6 1.6"/>
      </Shape>
    </Transform>
    <TimeSensor DEF="Clock" cycleInterval="1"/>
    <OrientationInterpolator DEF="Turn" key="0 0.25 0.5 0.75 1"
        keyValue="0 1 0 0, 0 1 0 1.5708, 0 1 0 3.1416, 0 1 0 4.7124, 0 1 0 6.2832"/>
    <ROUTE fromNode="Seen" fromField="enterTime" toNode="Clock" toField="set_startTime"/>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Turn" toField="set_fraction"/>
    <ROUTE fromNode="Turn" fromField="value_changed" toNode="Spinner" toField="set_rotation"/>
  </Scene>
</X3D>
