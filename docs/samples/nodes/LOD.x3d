<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="LOD"/>
    <meta name="description" content="Draws one child by the distance from the viewer to center: the first inside the first range, the second to the next, and the last beyond."/>
    <meta name="sample:interactive" content="true"/>
  </head>
  <Scene>
    <Viewpoint position="0 1 6.5" orientation="-1 -0 -0 0.1526"/>
    <!-- ranges are 4 and 9 units; the viewer is 6.6 away, so the second level, the sphere, is drawn. -->
    <LOD range="4 9" center="0 0 0">
      <Shape>
        <Appearance><Material diffuseColor="0.8 0.3 0.2"/></Appearance>
        <Box/>
      </Shape>
      <Shape>
        <Appearance><Material diffuseColor="0.25 0.6 0.85" specularColor="0.8 0.8 0.8" shininess="0.5"/></Appearance>
        <Sphere/>
      </Shape>
      <Shape>
        <Appearance><Material diffuseColor="0.4 0.75 0.3"/></Appearance>
        <Cone/>
      </Shape>
    </LOD>
  </Scene>
</X3D>
