<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="Box"/>
    <meta name="description" content="A box centred on the origin, its size the width, height and depth along x, y and z."/>
  </head>
  <Scene>
    <Viewpoint position="1.8 1.5 3.6" orientation="-0.6008 0.7867 0.1418 0.583"/>
    <Shape>
      <Appearance>
        <Material diffuseColor="0.8 0.35 0.15"/>
      </Appearance>
      <!-- Wider than it is tall, and as deep as it is tall. -->
      <Box size="2 1 1"/>
    </Shape>
  </Scene>
</X3D>
