<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="ElevationGrid"/>
    <meta name="description" content="A grid of heights over the x-z plane: xDimension by zDimension samples, spaced xSpacing and zSpacing apart, rising from the corner at the origin."/>
  </head>
  <Scene>
    <Viewpoint position="3.2 3.4 4.6" orientation="-0.6331 0.7481 0.1986 0.7939"/>
    <Transform translation="-1.5 0 -1.5">
      <Shape>
        <Appearance><Material diffuseColor="0.35 0.65 0.3"/></Appearance>
        <!-- Seven by seven heights, row by row along x; creaseAngle smooths the faces into one surface. -->
        <ElevationGrid xDimension="7" zDimension="7" xSpacing="0.5" zSpacing="0.5" creaseAngle="1.5"
            height="0 0.02 0.04 0.05 0.04 0.02 0 0.02 0.07 0.19 0.26 0.19 0.07 0.02 0.04 0.19 0.48 0.66 0.48 0.19 0.04 0.05 0.26 0.66 0.9 0.66 0.26 0.05 0.04 0.19 0.48 0.66 0.48 0.19 0.04 0.02 0.07 0.19 0.26 0.19 0.07 0.02 0 0.02 0.04 0.05 0.04 0.02 0"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
