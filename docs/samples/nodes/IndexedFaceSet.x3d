<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="IndexedFaceSet"/>
    <meta name="description" content="A surface built from faces that index a list of points: coordIndex names the points of each face, closed by -1, in counter-clockwise order seen from outside."/>
  </head>
  <Scene>
    <Viewpoint position="2.8 2.6 4.4" orientation="-0.5301 0.8337 0.1544 0.6721"/>
    <Shape>
      <Appearance><Material diffuseColor="0.8 0.6 0.25"/></Appearance>
      <!-- A square pyramid: the base, then the four sides. -->
      <IndexedFaceSet coordIndex="0 3 2 1 -1, 3 2 4 -1, 2 1 4 -1, 1 0 4 -1, 0 3 4 -1" solid="true" creaseAngle="0">
        <Coordinate point="-1 0 -1, 1 0 -1, 1 0 1, -1 0 1, 0 1.6 0"/>
      </IndexedFaceSet>
    </Shape>
  </Scene>
</X3D>
