#VRML V2.0 utf8
# META "title" "ProximitySensor"
# META "description" "Senses the viewer inside a box: isActive is true while the viewer is in the box set by center and size, with enterTime and exitTime, and position_changed and orientation_changed follow the viewer there."
# META "sample:interactive" "true"

Viewpoint {
  orientation -1 -0 -0 0.3709
  position 0 3.5 9
}
DEF Zone ProximitySensor {
  center 0 1 0
  size 6 2 6
}
Shape {
  appearance Appearance {
    material Material {
      emissiveColor 0.5 0.7 0.5
    }
  }
  geometry IndexedLineSet {
    coordIndex [ 0 1 2 3 0 -1 4 5 6 7 4 -1 0 4 -1 1 5 -1 2 6 -1 3 7 -1 ]
    coord Coordinate {
      point [ -3 0 -3, 3 0 -3, 3 0 3, -3 0 3, -3 2 -3, 3 2 -3, 3 2 3, -3 2 3 ]
    }
  }
}
Shape {
  appearance Appearance {
    material DEF Lamp Material {
      diffuseColor 0.3 0.3 0.1
    }
  }
  geometry Sphere {
    radius 0.5
  }
}
DEF On ColorInterpolator {
  key [ 0 1 ]
  keyValue [ 0.3 0.3 0.1, 1 0.9 0.2 ]
}
DEF Glow TimeSensor {
  cycleInterval 0.5
}
ROUTE Zone.enterTime TO Glow.set_startTime
ROUTE Glow.fraction_changed TO On.set_fraction
ROUTE On.value_changed TO Lamp.set_emissiveColor
