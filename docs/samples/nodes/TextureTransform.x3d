<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="TextureTransform"/>
    <meta name="description" content="Moves, turns and scales a texture over a surface; the same image on three boxes, plain, scaled to repeat and turned."/>
  </head>
  <Scene>
    <Viewpoint position="0 1.5 8.5" orientation="-1 -0 -0 0.1747"/>
    <Transform translation="-2.6 0 0" rotation="0 1 0 0.5">
      <Shape>
        <Appearance><ImageTexture url='"assets/checker.png"'/></Appearance>
        <Box size="1.8 1.8 1.8"/>
      </Shape>
    </Transform>
    <Transform rotation="0 1 0 0.5">
      <Shape>
        <Appearance>
          <ImageTexture url='"assets/checker.png"'/>
          <TextureTransform scale="3 3"/>
        </Appearance>
        <Box size="1.8 1.8 1.8"/>
      </Shape>
    </Transform>
    <Transform translation="2.6 0 0" rotation="0 1 0 0.5">
      <Shape>
        <Appearance>
          <ImageTexture url='"assets/checker.png"'/>
          <TextureTransform center="0.5 0.5" rotation="0.7854" translation="0.1 0"/>
        </Appearance>
        <Box size="1.8 1.8 1.8"/>
      </Shape>
    </Transform>
  </Scene>
</X3D>
