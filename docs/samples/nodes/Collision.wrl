#VRML V2.0 utf8
# META "title" "Collision"
# META "description" "A group the viewer can collide with; proxy stands in for the children when the collision is tested, and collide false lets the viewer walk through."
# META "sample:interactive" "true"

Viewpoint {
  orientation -0.6008 0.7867 0.1418 0.583
  position 1.8 1.5 3.6
}
Collision {
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.75 0.4 0.6
          shininess 0.4
          specularColor 0.7 0.7 0.7
        }
      }
      geometry Sphere {
        radius 1.1
      }
    }
  ]
  proxy Shape {
    geometry Box {
      size 2.2 2.2 2.2
    }
  }
}
