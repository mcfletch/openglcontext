#VRML V2.0 utf8
# META "title" "IndexedLineSet"
# META "description" "Lines through points that index a list: each run in coordIndex, closed by -1, is one polyline; lines are drawn unlit in the emissive colour or in their own Color."

Viewpoint {
  orientation -0.5017 0.8532 0.1427 0.6437
  position 2.6 2.2 4.2
}
Shape {
  appearance Appearance {
    material Material {
      emissiveColor 1 1 1
    }
  }
  geometry IndexedLineSet {
    colorPerVertex FALSE
    coordIndex [ 0 1 2 3 0 -1 0 4 -1 1 4 -1 2 4 -1 3 4 -1 ]
    color Color {
      color [ 1 0.3 0.3, 0.3 1 0.3, 0.3 0.5 1, 1 0.9 0.2, 0.9 0.4 1 ]
    }
    coord Coordinate {
      point [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1, 0 1.6 0 ]
    }
  }
}
