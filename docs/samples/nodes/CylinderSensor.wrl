#VRML V2.0 utf8
# META "title" "CylinderSensor"
# META "description" "Turns a drag on its shapes into a rotation about an axis: rotation_changed is the turn about the y axis, kept between minAngle and maxAngle, and diskAngle sets how steep a drag must be to turn rather than tilt."
# META "sample:interactive" "true"

Viewpoint {
  orientation -0.7782 0.6059 0.1651 0.6738
  position 2 3.2 4.5
}
DEF Knob Transform {
  children [
    DEF Dial CylinderSensor {
      diskAngle 0.2618
    }
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.4 0.5 0.8
        }
      }
      geometry Cylinder {
        height 0.5
        radius 1.2
      }
    }
    Transform {
      translation 0.6 0.3 0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.9 0.8 0.25
            }
          }
          geometry Box {
            size 1.1 0.12 0.18
          }
        }
      ]
    }
  ]
}
ROUTE Dial.rotation_changed TO Knob.set_rotation
