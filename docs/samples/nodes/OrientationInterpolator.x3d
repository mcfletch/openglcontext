<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="3.3">
  <head>
    <meta name="title" content="OrientationInterpolator"/>
    <meta name="description" content="Turns a rotation through the keyValue rotations as set_fraction passes the key fractions, along the shorter arc between each pair."/>
    <meta name="sample:frames" content="59"/>
  </head>
  <Scene>
    <Viewpoint position="0 0.5 6.5" orientation="-1 -0 -0 0.0768"/>
    <TimeSensor DEF="Clock" cycleInterval="4" loop="true"/>
    <!-- Three keys: at rest, a third of a turn about a slanting axis, and back. The render is a quarter of the way through. -->
    <OrientationInterpolator DEF="Tumble" key="0 0.5 1" keyValue="1 0 0 0, 1 1 0 2.0944, 1 0 0 0"/>
    <Transform DEF="Rotor">
      <Shape>
        <Appearance><Material diffuseColor="0.3 0.55 0.85"/></Appearance>
        <Box size="2.4 0.25 0.25"/>
      </Shape>
      <Transform translation="1.2 0 0">
        <Shape>
          <Appearance><Material diffuseColor="0.9 0.85 0.3"/></Appearance>
          <Sphere radius="0.35"/>
        </Shape>
      </Transform>
    </Transform>
    <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Tumble" toField="set_fraction"/>
    <ROUTE fromNode="Tumble" fromField="value_changed" toNode="Rotor" toField="set_rotation"/>
  </Scene>
</X3D>
