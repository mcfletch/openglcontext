include MANIFEST.in
include license.txt
include README.md

recursive-include tests *.jpg *.bmp *.png *.wrl *.jpeg
exclude tests/axis.wrl
exclude tests/flower.wrl
exclude tests/test.jpg
exclude tests/wrls/logo_installer.bmp
exclude tests/wrls/pyopenglchapel.wrl
include tests/*.py
include tests/*.vert
include tests/resources/*.txt

# The documentation's source: the pages, the Sphinx configuration and its
# extensions, templates and static files, the extension specifications, and
# the pictures. The generated pages (docs/tutorials/*.rst, docs/api/) and the
# built site are not source.
include build-docs.py docs/*.rst docs/conf.py
recursive-include docbuild *.py
recursive-include docs/_ext *.py
recursive-include docs/_templates *.html
recursive-include docs/_static *.css *.js
recursive-include docs/extensions *.rst *.json *.gltf
recursive-include docs/images *.png *.jpg *.gif *.svg *.toml *.md *.json
include docs/tutorials/*.png docs/tutorials/physics_getting_started.rst
include OpenGLContext/resources/*.txt
include OpenGLContext/loaders/*
prune docs/_build
prune docs/api
exclude tests/test-results/*.png
exclude tests/test-results/*.html

# AI-workflow / internal planning docs are not user-facing; keep them out of the
# published sdist.
exclude CLAUDE.md
prune plans

global-exclude *CVS*
global-exclude *Cvs*
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pdb
global-exclude *.db
global-exclude *.max
global-exclude *.gz
global-exclude *.bat
global-exclude *.profile
global-exclude *.directory
global-exclude *.cvsignore
global-exclude *.ttf

